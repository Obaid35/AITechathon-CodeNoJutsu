# =============================================================================
# NaqsKAR Configuration
# =============================================================================

# LLM Provider (claude | ollama)
ANTHROPIC_API_KEY=sk-ant-your-key-here
APP_LLM_PROVIDER=claude

# Module Strategies (llm | keyword | none)
APP_NORMALIZER_STRATEGY=llm
APP_CLASSIFIER_STRATEGY=llm
APP_GEO_STRATEGY=llm_gazetteer
APP_DEDUP_STRATEGY=embedding

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Deduplication
DEDUP_WINDOW_DAYS=7
DEDUP_RADIUS_METERS=500

# Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

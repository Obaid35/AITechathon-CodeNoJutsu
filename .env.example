# =============================================================================
# NaqsKAR Configuration
# =============================================================================

# LLM Provider (openrouter | ollama)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
APP_LLM_PROVIDER=openrouter

# Module Strategies (llm | keyword | none)
APP_NORMALIZER_STRATEGY=llm
APP_CLASSIFIER_STRATEGY=llm
APP_GEO_STRATEGY=llm_gazetteer
APP_DEDUP_STRATEGY=embedding

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Deduplication
DEDUP_WINDOW_DAYS=7
DEDUP_RADIUS_METERS=500

# Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
